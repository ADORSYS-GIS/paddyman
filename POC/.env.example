# POC/.env.example - secrets only
# Copy to POC/.env and fill in private values.
# Non-sensitive application configuration belongs in POC/config.yml.

# GitLab.com personal access token for private repos or rate-limit avoidance.
GITLAB_PERSONAL_ACCESS_TOKEN=your_gitlab_com_token_here

# Adorsys GitLab token for private Adorsys repositories.
ADORSYS_GITLAB_TOKEN=your_adorsys_gitlab_token_here

# HuggingFace token used by Docling when model downloads require authentication.
HF_TOKEN=your_huggingface_token_here

# OpenAI key used only when Docling picture mode or semantic chunking requires it.
OPENAI_API_KEY=your_openai_api_key_here

# Embedding provider authentication secret.
EMBED_API_KEY=your_embedding_api_key_here

# LLM provider authentication secret.
LLM_API_KEY=your_llm_api_key_here

# Neo4j credentials.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Optional authentication/client secrets.
# CLIENT_SECRET=your_client_secret_here
# PRIVATE_CERTIFICATE_PATH=/secure/path/to/private-certificate.pem